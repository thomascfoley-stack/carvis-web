# ============================================================================
# JARVIS Web — environment
# Set these in Vercel → Project → Settings → Environment Variables.
# Nothing here belongs in the repo.
# ============================================================================

# ---- Integrations + login (required) ---------------------------------------
# One key powers every integration AND brokers the Google sign-in.
COMPOSIO_API_KEY=
# Identifies you inside Composio. Any stable string.
COMPOSIO_USER_ID=default

# ---- Access control --------------------------------------------------------
# Comma-separated Google addresses allowed to sign in.
# LEAVE BLANK AND THE APP IS PUBLIC — set this before sharing the URL.
JARVIS_ALLOWED_EMAILS=you@example.com
# Optional: pins session cookies across key rotations. Any long random string.
JARVIS_AUTH_SECRET=

# ---- Language model --------------------------------------------------------
# Defaults suit Moonshot/Kimi; change provider and model in Settings.
MOONSHOT_API_KEY=
JARVIS_LLM_PROVIDER=moonshot
JARVIS_FAST_MODEL=kimi-k2.7-code-highspeed
# Only needed for a custom / self-hosted endpoint:
# JARVIS_BASE_URL=

# ---- Voice -----------------------------------------------------------------
JARVIS_TTS_PROVIDER=fish
FISH_API_KEY=
FISH_VOICE_ID=612b878b113047d9a770c069c8b4fdfe
FISH_MODEL=speech-1.6

# ---- Memory + settings persistence (optional but recommended) --------------
# Any Redis-over-HTTP endpoint (Vercel KV or Upstash). Without it, remembered
# facts and any settings changed in the UI reset when the server recycles.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Personality -----------------------------------------------------------
USER_NAME=sir
